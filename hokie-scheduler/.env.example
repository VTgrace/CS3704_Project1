# Server only. Copy to .env; never use VITE_ for secrets or commit .env.
PORT=3001
# Optional: both are required to enable the LLM. Pick a model available to your API account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: approved Reddit Data API OAuth access (read scope). Renew expired tokens yourself.
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=
# Optional: absolute path to a permitted review-data export (see server/README.md).
RMP_IMPORT_FILE=
# Alternative Reddit authentication: approved confidential app credentials.
# Uses application-only OAuth unless a user refresh token is supplied.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# Optional normalized HTTPS feed issued by an authorized data provider.
RMP_FEED_URL=
RMP_FEED_TOKEN=
# Optional dated official catalog export when live catalog pages are unavailable.
VT_CATALOG_IMPORT_FILE=
