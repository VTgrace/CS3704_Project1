{
  "name": "hokie-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:client\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "tsx --test src/services/*.test.ts server/tests/*.test.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx server/doctor.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "openai": "^7.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}
